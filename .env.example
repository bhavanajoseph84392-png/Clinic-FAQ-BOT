# Database Connections
DATABASE_URL=postgresql://app_user:***REMOVED***@localhost:5432/clinic_faq
MIGRATION_DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/clinic_faq

# Security
SECRET_KEY=generate_a_secure_random_hex_key_here

# AI Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
ANSWER_MODEL=gemini-2.5-flash
CHECK_MODEL=gemini-2.5-flash
EMBED_MODEL=text-embedding-004

# Email Provider (resend or smtp)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key
MAIL_FROM=support@yourclinicdomain.com

# SMTP Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_***REMOVED***

# Application Settings
APP_BASE_URL=http://localhost:8000
LESSON_THRESHOLD=0.85
KNOWLEDGE_THRESHOLD=0.55
DAILY_AI_BUDGET_PER_CLINIC=500
